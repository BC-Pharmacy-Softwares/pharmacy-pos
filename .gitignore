# ============================================================
# Pharmacy POS — .gitignore
# Safe to publish: each pharmacy fills in their own config.
# ============================================================

# --- WinRx SQL Server credentials (NEVER commit) ---
# Real server/user/password for the pharmacy's WinRx database. The app reads it
# from %AppData%\pharmacy-pos\ first (written by Settings -> WinRx Connection),
# so this file is only ever a local dev convenience.
# Copy sql-config.example.json to sql-config.json and fill it in.
electron-app/sql-config.json

# --- Clover bridge service ---
clover-local-pay/.env            # contains your Clover device IP & port
clover-local-pay/.clover-token   # pairing token saved after first connect
clover-local-pay/node_modules/
clover-local-pay/*.log

# --- Database exports (may contain patient/transaction data) ---
pharmacy_pos_export_*.json

# --- Downloaded libraries (re-fetched by setup scripts) ---
lib/sql-wasm.js
lib/sql-wasm.wasm
lib/bcrypt.min.js

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# --- Electron build output / dependencies (built on Windows or in CI) ---
electron-app/node_modules/
electron-app/dist/
