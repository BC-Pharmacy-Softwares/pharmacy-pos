# ============================================================
# Clover Local Pay — Network Pay Display (WebSocket)
# Copy this file to .env and fill in your values.
# No OAuth token needed — pairing uses a code shown on device.
# ============================================================

# IP address of your Clover terminal
# (shown in the Network Pay Display app on the device screen)
CLOVER_DEVICE_IP=192.168.1.100

# WebSocket port — default is 12345, do not change unless the device shows a different value
CLOVER_DEVICE_PORT=12345

# A name for this POS station (shown on the Clover screen during pairing)
CLOVER_POS_ID=PharmacyPOS

# Port this Node.js service listens on (the POS connects to this)
PORT=3001
